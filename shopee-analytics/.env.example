# Dedicated analytics DB. Never falls back to the inventory DATABASE_URL implicitly.
# Use either DATABASE_URL OR the dedicated discrete PG fields below.
SHOPEE_ANALYTICS_DATABASE_URL=
SHOPEE_ANALYTICS_PGHOST=
SHOPEE_ANALYTICS_PGPORT=5432
SHOPEE_ANALYTICS_PGDATABASE=
SHOPEE_ANALYTICS_PGUSER=
SHOPEE_ANALYTICS_PGPASSWORD=

# 32-byte random key encoded as base64; encrypts refresh/access tokens at rest.
SHOPEE_TOKEN_MASTER_KEY=

# Explicit write gates for local/manual scripts.
SHOPEE_ANALYTICS_BOOTSTRAP_TOKENS=NO
SHOPEE_ANALYTICS_APPLY_SCHEMA=NO
SHOPEE_ANALYTICS_ENABLE_SYNC=NO

# Target shop
SHOPEE_SHOP_ID=

# Ads app
SHOPEE_ADS_PARTNER_ID=
SHOPEE_ADS_PARTNER_KEY=
SHOPEE_ADS_ACCESS_TOKEN=
SHOPEE_ADS_REFRESH_TOKEN=
SHOPEE_ADS_TOKEN_EXPIRES_AT=

# Store Operations app (Voucher / Discount)
SHOPEE_STORE_OPS_PARTNER_ID=
SHOPEE_STORE_OPS_PARTNER_KEY=
SHOPEE_STORE_OPS_ACCESS_TOKEN=
SHOPEE_STORE_OPS_REFRESH_TOKEN=
SHOPEE_STORE_OPS_TOKEN_EXPIRES_AT=

# ERP app (Returns / BusinessInsights)
SHOPEE_ERP_PARTNER_ID=
SHOPEE_ERP_PARTNER_KEY=
SHOPEE_ERP_ACCESS_TOKEN=
SHOPEE_ERP_REFRESH_TOKEN=
SHOPEE_ERP_TOKEN_EXPIRES_AT=

# Brand Portal app
SHOPEE_BRAND_PORTAL_PARTNER_ID=
SHOPEE_BRAND_PORTAL_PARTNER_KEY=
SHOPEE_BRAND_PORTAL_ACCESS_TOKEN=
SHOPEE_BRAND_PORTAL_REFRESH_TOKEN=
SHOPEE_BRAND_PORTAL_TOKEN_EXPIRES_AT=

# Manual sync inputs
SHOPEE_SYNC_TIME_FROM=
SHOPEE_SYNC_TIME_TO=
SHOPEE_BI_DATE=
SHOPEE_BI_TIMEZONE=
SHOPEE_ROI_ITEM_IDS=
SHOPEE_GMS_CAMPAIGN_ID=
SHOPEE_GMS_START_DATE=
SHOPEE_GMS_END_DATE=


# Product Card manual import (until a complete item-level BI API is verified)
SHOPEE_ANALYTICS_IMPORT_PRODUCT_CARD=NO
SHOPEE_PRODUCT_CARD_FILE=
SHOPEE_PRODUCT_CARD_SHEET=
SHOPEE_PRODUCT_CARD_START_DATE=
SHOPEE_PRODUCT_CARD_END_DATE=


# Recurring sync cycle
SHOPEE_ANALYTICS_ENABLE_SYNC_CYCLE=NO
SHOPEE_SHOP_TIMEZONE=Asia/Jakarta
SHOPEE_BI_TIMEZONE=
# Optional seed list. Once a campaign is successfully synced as GMS it is remembered in DB.
SHOPEE_GMS_CAMPAIGN_IDS=


# Multi-country / multi-brand shop directory
SHOPEE_ANALYTICS_CONFIGURE_SHOPS=NO
SHOPEE_SHOP_PROFILES_FILE=
SHOPEE_SHOP_PROFILES_JSON=

# Multi-shop recurring sync
SHOPEE_ANALYTICS_ENABLE_SYNC_ALL_SHOPS=NO
# Optional filters for a scheduled subset
SHOPEE_SYNC_COUNTRY=
SHOPEE_SYNC_BRAND=
SHOPEE_SYNC_SHOP_IDS=


# Backward-compatible single-shop fallback when no shop profile exists
SHOPEE_SHOP_DISPLAY_NAME=
SHOPEE_SHOP_COUNTRY=
SHOPEE_SHOP_BRAND=


# One-time encrypted token bootstrap for multiple shops.
# File must stay outside Git and should be deleted after import.
SHOPEE_ANALYTICS_BOOTSTRAP_MULTI_SHOP_TOKENS=NO
SHOPEE_MULTI_SHOP_TOKEN_FILE=


# Per-shop operating strategy (e.g. ad spend ratio limit, weekly order reference)
SHOPEE_ANALYTICS_CONFIGURE_STRATEGY=NO
SHOPEE_STRATEGY_CONFIG_FILE=
SHOPEE_STRATEGY_CONFIG_JSON=


# Read-only first-live-data acceptance report
SHOPEE_VALIDATION_SHOP_ID=
SHOPEE_VALIDATION_START_DATE=
SHOPEE_VALIDATION_END_DATE=


# Historical backfill across active shops
SHOPEE_ANALYTICS_ENABLE_BACKFILL=NO
SHOPEE_BACKFILL_START_DATE=
SHOPEE_BACKFILL_END_DATE=
# Optional comma-separated subset:
# shop-info,campaigns,gms,orders,returns,shop-bi,products,promotions,roi
SHOPEE_BACKFILL_SOURCES=
SHOPEE_BACKFILL_COUNTRY=
SHOPEE_BACKFILL_BRAND=
SHOPEE_BACKFILL_SHOP_IDS=


# Always-on sync scheduler (desktop deployment)
SHOPEE_SYNC_HOURLY_MINUTE=10
SHOPEE_SYNC_DAILY_UTC_HOUR=2
SHOPEE_SYNC_DAILY_UTC_MINUTE=30
SHOPEE_SYNC_RUN_ON_START=NO

# Optional backup-status JSON written by desktop/NAS backup task
SHOPEE_BACKUP_STATUS_FILE=


# Item-level profitability thresholds
SHOPEE_ANALYTICS_CONFIGURE_ITEM_STRATEGY=NO
SHOPEE_ITEM_STRATEGY_FILE=
SHOPEE_ITEM_STRATEGY_JSON=


# Optional Product Card drop-folder automation (desktop worker)
SHOPEE_PRODUCT_CARD_INBOX_ENABLE=NO
SHOPEE_PRODUCT_CARD_INBOX_DIR=
SHOPEE_PRODUCT_CARD_ARCHIVE_DIR=
SHOPEE_PRODUCT_CARD_FAILED_DIR=
