# Docker/PostgreSQL
# Defaults to production. OFFLINE_BASELINE is only for local Docker/PostgreSQL/schema/app/idle-worker verification.
# In OFFLINE_BASELINE, Partner credentials, OpenAI configuration, sync, Product Card import, and Skill reports are blocked.
SHOPEE_ANALYTICS_DEPLOYMENT_MODE=PRODUCTION
POSTGRES_DB=shopee_analytics
POSTGRES_USER=shopee_analytics
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
SHOPEE_ANALYTICS_HOST_PORT=3090

# Token encryption. Generate a random 32-byte base64 key.
SHOPEE_TOKEN_MASTER_KEY=

# App credentials. Keep these only on the desktop server.
SHOPEE_ADS_PARTNER_ID=
SHOPEE_ADS_PARTNER_KEY=
SHOPEE_STORE_OPS_PARTNER_ID=
SHOPEE_STORE_OPS_PARTNER_KEY=
SHOPEE_ERP_PARTNER_ID=
SHOPEE_ERP_PARTNER_KEY=
SHOPEE_BRAND_PORTAL_PARTNER_ID=
SHOPEE_BRAND_PORTAL_PARTNER_KEY=

# Skill runtime. Leave provider empty to keep report generation fail-closed.
# Store the API key only in the local runtime/.env; never commit a real key.
SHOPEE_SKILL_RUNTIME_PROVIDER=
SHOPEE_SKILL_OPENAI_API_KEY=
SHOPEE_SKILL_OPENAI_MODEL=gpt-5.6-terra
SHOPEE_SKILL_OPENAI_REASONING_EFFORT=medium
SHOPEE_SKILL_OPENAI_MAX_OUTPUT_TOKENS=12000
SHOPEE_SKILL_OPENAI_TIMEOUT_MS=180000
SHOPEE_SKILL_DAILY_WINDOW_DAYS=14

# Recurring multi-shop sync
SHOPEE_SYNC_HOURLY_MINUTE=10
# 02:30 UTC = 09:30 Jakarta/Bangkok, 10:30 Kuala Lumpur/Singapore.
SHOPEE_SYNC_DAILY_UTC_HOUR=2
SHOPEE_SYNC_DAILY_UTC_MINUTE=30
SHOPEE_SYNC_RUN_ON_START=YES

# Optional filters. Leave empty to sync all active shops.
SHOPEE_SYNC_COUNTRY=
SHOPEE_SYNC_BRAND=
SHOPEE_SYNC_SHOP_IDS=

# PILOT_GMV_MAX only: enforce a single Indonesia shop and independent formal-sync allowlists.
SHOPEE_PILOT_GMV_MAX_SHOP_ID=
SHOPEE_PILOT_GMV_MAX_BRAND=
# Deprecated: discovery compatibility only. It never authorizes formal sync.
SHOPEE_PILOT_GMV_MAX_CAMPAIGN_IDS=
SHOPEE_PILOT_SHOP_GMV_MAX_CAMPAIGN_IDS=
SHOPEE_PILOT_INDIVIDUAL_AD_CAMPAIGN_IDS=

# OAuth is a separate, Pilot-only service. Keep disabled until a real HTTPS callback is provisioned.
SHOPEE_OAUTH_ENABLE=NO
SHOPEE_OAUTH_LIVE_REDIRECT_URL=
# Reserved for future sandbox support. It is never sent to the production Shopee base URL.
SHOPEE_OAUTH_TEST_REDIRECT_URL=
SHOPEE_OAUTH_STATE_TTL_SECONDS=600
SHOPEE_OAUTH_HOST=127.0.0.1
SHOPEE_OAUTH_PORT=3091
SHOPEE_OAUTH_ALLOW_REMOTE=NO

# Host backup scripts consume these paths.
SHOPEE_BACKUP_LOCAL_DIR=./runtime/backup-local
SHOPEE_NAS_BACKUP_DIR=

# Optional Product Card drop-folder automation
# Filename: shop-<shopId>__Product_Card.YYYYMMDD_YYYYMMDD.xlsx
SHOPEE_PRODUCT_CARD_INBOX_ENABLE=NO
