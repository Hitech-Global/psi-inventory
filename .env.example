# 进销存管理系统 - 环境变量配置模板
# 复制为 .env 并按生产环境填写。切勿把真实密钥提交到 git（.env 已在 .gitignore）。

# == 运行环境 ==
# 生产必须设为 production：否则 CSRF 防护不强制、错误栈可能外泄
NODE_ENV=production

# 服务端口
PORT=3001

# 数据库文件路径（生产指向持久化磁盘卷；WAL 三文件 .db/.db-wal/.db-shm 同盘）
DB_PATH=/data/inventory.db

# == 本地应急管理员（break-glass）==
# 缺失或为弱值将 fail-closed 拒绝启动。请用强密码。
BREAKGLASS_ADMIN_PASSWORD=

# == 飞书 OAuth（独立应用，勿与售后系统共用）==
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 生产回调地址，须与飞书后台安全设置白名单一致
FEISHU_REDIRECT_URI=https://your-domain.example.com/api/auth/feishu/callback

# == 安全 ==
# CSRF 可信来源（逗号分隔），生产填正式域名 origin
TRUSTED_ORIGINS=https://your-domain.example.com
# HTTPS 环境置 1，使会话 Cookie 带 Secure 标志
COOKIE_SECURE=1
# 会话有效期（小时）
SESSION_TTL_HOURS=12

# == 飞书通知（可选）==
# 生产默认真实发送（best-effort，不阻断业务）。真实送达依赖飞书后台已开启机器人 + im:message 权限。
# 演练/联调时可临时置 1，仅内存记录 payload 不真实发送：
# FEISHU_NOTIFY_DRYRUN=1
